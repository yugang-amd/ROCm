#: ../../conceptual/gpu-arch/mi350-performance-counters.rst:442
msgid "TCP_TAGRAM2_REQ"
msgstr "TCP_TAGRAM2_REQ"

#: ../../conceptual/gpu-arch/mi350-performance-counters.rst:443
msgid "Total L2 requests mapping to TagRAM 2 from this TCP to all TCCs."
