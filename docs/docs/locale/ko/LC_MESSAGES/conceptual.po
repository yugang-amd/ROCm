msgstr "비행 중 카운터 포화로 인해 모든 UTCL1이 정지합니다."

#: ../../conceptual/gpu-arch/mi350-performance-counters.rst:418
msgid "TCP_UTCL1_STALL_LRU_INFLIGHT"
msgstr "TCP_UTCL1_STALL_LRU_INFLIGHT"

