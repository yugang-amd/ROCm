"Percentage of GPU time ALU units are stalled due to the LDS input queue "
"being full or the output queue not being ready (value range: 0% (optimal)"
" to 100%)"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid "``FetchSize``"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid ""
"Total kilobytes fetched from the video memory; measured with all extra "
"fetches and any cache or memory effects taken into account"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid "``FlatLDSInsts``"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid ""
"Average number of flat instructions that read from or write to LDS, run "
"per work item (affected by flow control)"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid "``FlatVMemInsts``"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid ""
"Average number of flat instructions that read from or write to the video "
"memory, run per work item (affected by flow control). Includes flat "
"instructions that read from or write to scratch"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid "``GDSInsts``"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid ""
"Average number of global data share read or write instructions run per "
"work item (affected by flow control)"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid "``GPUBusy``"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid "Percentage of time GPU is busy"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid "``L2CacheHit``"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid ""
"Percentage of fetch, write, atomic, and other instructions that hit the "
"data in L2 cache (value range: 0% (no hit) to 100% (optimal))"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid "``LDSBankConflict``"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid ""
"Percentage of GPU time LDS is stalled by bank conflicts (value range: 0% "
"(optimal) to 100%)"
msgstr ""

