msgid "``SALUInsts``"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid ""
"Average number of scalar ALU instructions run per work item (affected by "
"flow control)"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid "``SFetchInsts``"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid ""
"Average number of scalar fetch instructions from the video memory run per"
" work item (affected by flow control)"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid "``VALUBusy``"
msgstr ""

#: ../../conceptual/gpu-arch/mi300-mi200-performance-counters.rst:1
msgid ""
"Percentage of GPU time vector ALU instructions are processed (value "
"range: 0% to 100% (optimal))"
msgstr ""

