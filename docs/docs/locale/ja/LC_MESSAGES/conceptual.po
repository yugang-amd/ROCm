msgstr "TCC_EA0_WRREQ_WRITE_DRAM_32B"

#: ../../conceptual/gpu-arch/mi350-performance-counters.rst:515
msgid ""
"Number of 32-byte TCC/EA write requests due to DRAM traffic. One 64-byte "
"request is counted as two."
msgstr ""
"DRAMトラフィックによる32バイトのTCC/EA書き込み要求の数。64バイトの要求1回は2"
"回としてカウントされます。"

#: ../../conceptual/gpu-arch/mi350-performance-counters.rst:517
msgid "TCC_EA0_WRREQ_ATOMIC_DRAM_32B"
msgstr "TCC_EA0_WRREQ_ATOMIC_DRAM_32B"

#: ../../conceptual/gpu-arch/mi350-performance-counters.rst:518
msgid ""
"Number of 32-byte TCC/EA atomic requests due to DRAM traffic. One 64-byte"
